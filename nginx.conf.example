# =====================================================================
# Nginx 1.26 - API Manager 站点配置示例
# =====================================================================
# 部署目录假设：/var/www/api-manager
# 入口文件：index.php（根目录），静态资源：/assets/*
# 用法：
#   1. 复制本文件到  /etc/nginx/sites-available/api-manager.conf
#   2. ln -s /etc/nginx/sites-available/api-manager.conf /etc/nginx/sites-enabled/
#   3. nginx -t && systemctl reload nginx
# =====================================================================

server {
    listen       80;
    listen       [::]:80;
    server_name  your-domain.com;

    # 强制 HTTPS（如启用 SSL，请取消注释）
    # return 301 https://$host$request_uri;

    root  /var/www/api-manager;
    index index.php;

    charset utf-8;
    client_max_body_size 8M;

    # 安全头
    add_header X-Frame-Options          "SAMEORIGIN" always;
    add_header X-Content-Type-Options   "nosniff"    always;
    add_header Referrer-Policy          "no-referrer-when-downgrade" always;
    add_header X-XSS-Protection         "1; mode=block" always;

    # 隐藏敏感文件
    location ~ /\.(?!well-known).* { deny all; }
    location ~ /(config\.php|composer\.(json|lock)|README\.md|sql/|src/|controllers/|views/|bootstrap\.php|data/) {
        deny all;
        return 404;
    }

    # 静态资源
    location /assets/ {
        alias /var/www/api-manager/public/assets/;
        access_log off;
        expires 7d;
        add_header Cache-Control "public, max-age=604800";
        try_files $uri =404;
    }

    # 安装向导
    location = /install.php {
        try_files $uri =404;
        fastcgi_pass   unix:/run/php/php8.2-fpm.sock;   # 根据实际 PHP-FPM socket 调整
        fastcgi_index  index.php;
        fastcgi_param  SCRIPT_FILENAME  $document_root$fastcgi_script_name;
        include        fastcgi_params;
    }

    # 主入口（伪静态：所有请求转发到 index.php）
    location / {
        try_files $uri $uri/ /index.php?$query_string;
    }

    # PHP 处理
    location ~ \.php$ {
        try_files $uri =404;
        fastcgi_split_path_info ^(.+\.php)(/.+)$;
        fastcgi_pass   unix:/run/php/php8.2-fpm.sock;
        fastcgi_index  index.php;
        fastcgi_param  SCRIPT_FILENAME  $document_root$fastcgi_script_name;
        fastcgi_param  PATH_INFO        $fastcgi_path_info;
        include        fastcgi_params;

        fastcgi_buffers          16 16k;
        fastcgi_buffer_size      32k;
        fastcgi_read_timeout     60s;
    }

    # 日志
    access_log /var/log/nginx/api-manager.access.log;
    error_log  /var/log/nginx/api-manager.error.log warn;
}

# =====================================================================
# HTTPS 配置示例（如使用 Let's Encrypt / 阿里云 / 自有证书）
# =====================================================================
